      "website": [
        "src/modules/{admin,classSchedule,coming-soon,customer,docs,hub,identity,ops-manual,promotions,promotions-guide,transfers,vouchers,website}/**"
      ],
      "admin": [
        "src/modules/{admin,booking-policies,classSchedule,customer,launch-receipts,maintenance,marketing,media,notifications,products,promotions,staff,teacher,transfers,vouchers}/**"
      ]
    },
    "seams": [
      {
        "from": "src/modules/*/index.ts"
      }
    ],
    "dynamic": {
      "scripts/ci/affected-areas.mjs": [],
      "scripts/ci/area-imports.mjs": [],
      "vite.config.ts": [],
      "scripts/test-route-connectivity.mjs": []
