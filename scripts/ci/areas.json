  "graph": {
    "sources": [
      "src/**/*.{ts,tsx}"
    ],
    "roots": [
      "src/main.tsx",
      "src/app/**",
      "src/auth/**"
    ],
    "entries": {
      "auth": [
        "src/modules/{admin,customer,dev,docs,hub,identity,ops-manual,staff,teacher,vouchers}/**"
      ],
      "customer": [
        "src/modules/{admin,classSchedule,customer,hub,identity,launch-receipts,quotes,transfers,voucher-gifts,vouchers}/**"
