{
  "name": "hoyos",
  "private": true,
  "version": "0.25.0",
  "type": "module",
  "description": "HoyOS \u2014 operations system for HOY Wellness Center (multi-tenant ready)",
  "scripts": {
    "dev": "vite",
    "build": "npm run media-catalog && npm run tokens && node scripts/spacing-lint.mjs --report && npm run hub-map && npm run actions && npm run capture-dates && node scripts/manual-lint.mjs --report && tsc --noEmit && vite build && node scripts/copy-shots.mjs && node scripts/write-release.mjs",
    "build:production": "npm run media-catalog && npm run tokens && npm run hub-map && npm run actions && npm run capture-dates && tsc --noEmit && VITE_HOY_BUILD=production vite build && node scripts/prune-production.mjs && node scripts/write-release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "thumbnails": "node scripts/screenshots.mjs --thumbs",
    "tokens": "node --experimental-strip-types scripts/gen-tokens.mjs",
    "specs": "node scripts/gen-specs.mjs",
    "sql": "node --experimental-strip-types scripts/gen-sql.mjs",
    "flow-map": "node scripts/gen-flow-map.mjs",
    "hub-map": "node scripts/gen-hub-map.mjs",
    "actions": "node scripts/gen-actions.mjs",
    "capture-dates": "node scripts/gen-capture-dates.mjs",
    "lint:manual": "node scripts/manual-lint.mjs",
    "hub-map:check": "node scripts/check-sample-routes.mjs",
    "lint:spacing": "node scripts/spacing-lint.mjs",
    "audit:spacing": "node scripts/spacing-audit.mjs",
    "test:pay-frame": "node scripts/test-pay-page-frame.mjs",
    "test:dates": "node --experimental-strip-types scripts/test-date-keys.mjs",
    "test:holidays": "node --experimental-strip-types scripts/test-holidays.mjs",
    "test:hours": "node --experimental-strip-types scripts/test-hours.mjs",
    "test:contacts": "node scripts/test-contacts.mjs",
    "test:analytics": "node scripts/test-analytics.mjs",
    "test:promotions": "node --experimental-strip-types scripts/test-promotions.mjs",
    "test:book": "node scripts/test-hoy-12nov-book.mjs",
    "test:fix-12nov": "node scripts/test-hoy-12nov-fix.mjs",
    "test:r1-12nov": "node scripts/test-hoy-12nov-r1.mjs",
    "test:vouchers": "node --experimental-strip-types scripts/test-vouchers.mjs",
    "test:teacher-codes": "node scripts/test-teacher-codes.mjs",
    "media-catalog": "node scripts/gen-media-catalog.mjs",
    "test:subscriptions": "node --experimental-strip-types scripts/test-subscriptions.mjs && node scripts/test-subscription-expenses.mjs",
    "test:content-recovery": "node scripts/test-content-recovery.mjs && node scripts/test-content-recovery-context.mjs && node scripts/test-content-batch.mjs",
    "test:content-recovery:ui": "node scripts/test-content-recovery-ui.mjs && node scripts/test-content-recovery-context-ui.mjs",
    "test:session-admission": "node scripts/test-session-admission.mjs",
    "test:delivery-room": "node scripts/test-delivery-room.cjs",
    "test:auth:real-clerk": "node scripts/test-auth-real-clerk.mjs",
    "test:jas-customer": "node scripts/test-jas-1nov-customer.mjs",
    "test:jas-customer:ui": "node scripts/test-jas-1nov-customer-ui.mjs",
    "seed:companyos": "node scripts/seed-companyos.ts ../Company-OS/deploy/seeds",
    "test:seed-companyos": "node scripts/test-seed-companyos.mjs",
    "test:jas-1nov-admin": "node scripts/test-jas-1nov-admin.mjs",
    "test:jas-1nov-admin:ui": "node scripts/test-jas-1nov-admin-ui.mjs",
    "test:test-gate": "node scripts/test-test-gate.mjs",
    "test:test-gate:ui": "node scripts/test-test-gate-ui.mjs",
    "test:seo": "node --experimental-strip-types scripts/test-seo.mjs"
  },
  "dependencies": {
    "@clerk/react": "6.17.8",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "^1.47.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
