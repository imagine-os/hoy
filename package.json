{
  "name": "hoyos",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "HoyOS — operations system for HOY Wellness Center (multi-tenant ready)",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "tokens": "node --experimental-strip-types scripts/gen-tokens.mjs",
    "specs": "node scripts/gen-specs.mjs",
    "sql": "node --experimental-strip-types scripts/gen-sql.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "^1.47.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
